# Copy to .env.local and fill in from Supabase: Project Settings -> API.
# Leave empty to run ReconPilot with a browser-only workspace (no database).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Shared demo login behind the "Try the live demo" button. Anyone can use it,
# so never reuse a real password here. RLS keeps the demo's rows separate.
VITE_DEMO_EMAIL=demo@reconpilot.app
VITE_DEMO_PASSWORD=
